APP_ENV=production
HTTP_ADDR=:8080
CAPTCHA_HMAC_SECRET=generate-on-server-at-least-32-bytes
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=hhy
DATABASE_USER=hhy
DATABASE_PASSWORD=change-on-server
REDIS_HOST=redis
REDIS_PORT=6379
PUBLIC_API_HOST=hhy-api.orbexa.cc
PUBLIC_ADMIN_HOST=hhy-admin.orbexa.cc
PUBLIC_H5_HOST=hhy-h5.orbexa.cc
STORAGE_PUBLIC_BASE_URL=https://oss.orbexa.cc
STORAGE_S3_ENDPOINT=server-only-value
STORAGE_BUCKET=fuylink
STORAGE_PROJECT_PREFIX=hhy/prod/
STORAGE_ACCESS_KEY_ID=server-only
STORAGE_SECRET_ACCESS_KEY=server-only
SMTP_HOST=server-only
SMTP_PORT=465
SMTP_USERNAME=server-only
SMTP_PASSWORD=server-only
IDENTITY_PROVIDER_URL=server-only
IDENTITY_PROVIDER_APPCODE=server-only
FUYUN_BASE_URL=server-only
FUYUN_PID=server-only
FUYUN_KEY=server-only
XAPAY_GATEWAY_URL=server-only
XAPAY_PID=server-only
XAPAY_KEY=server-only
ALIPAY_PAYOUT_APP_ID=server-only
ALIPAY_PAYOUT_PRIVATE_KEY=server-only
ALIPAY_PAYOUT_CERTIFICATE_PATH=/run/secrets/hhy-payout.p12
# Never place access keys, SMTP passwords, payment keys, or certificates in this file in Git.
